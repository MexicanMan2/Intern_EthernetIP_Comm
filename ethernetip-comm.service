[Unit]
Description=EthernetIP OPC UA Communication Service
After=network.target

[Service]
User=twin
WorkingDirectory=/home/twin/intern-ethernetip-comm
ExecStart=/home/twin/intern-ethernetip-comm/.venv/bin/python src/main.py
Restart=always
RestartSec=5
StandardOutput=syslog
StandardError=syslog
SyslogIdentifier=ethernetip-comm

[Install]
WantedBy=multi-user.target
